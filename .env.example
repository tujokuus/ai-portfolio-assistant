# Reference only: the application does NOT automatically load .env files.
# Set this variable in your terminal or deployment secret manager.
OPENAI_API_KEY=

# Per-IP rolling request limits (defaults: 20 per hour, 40 per day).
CHAT_IP_HOURLY_LIMIT=20
CHAT_IP_DAILY_LIMIT=40

# Service-wide rolling limits across all visitors (defaults: 20 per hour, 100 per day).
CHAT_HOURLY_LIMIT=20
CHAT_DAILY_LIMIT=100
